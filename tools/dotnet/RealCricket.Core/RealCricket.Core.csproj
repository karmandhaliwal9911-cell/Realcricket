<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RealCricket.Core — the engine-independent, deterministic simulation.
    Architecture contract (docs/02-architecture.md): this assembly must never
    reference UnityEngine, UnityEditor, or any Unity package. It must be
    buildable and testable with a plain .NET SDK on a machine that has no Unity.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>RealCricket.Core</AssemblyName>
    <RootNamespace>RealCricket.Core</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>0.1.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
